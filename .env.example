# Copia este archivo a .env (ignorado por git). En la nube, los secretos van en AWS Secrets Manager / SSM.
STAGE=dev-tualias
AWS_REGION=us-east-1
# AWS Academy Learner Lab: las credenciales (con session token) se copian desde "AWS Details"
# a ~/.aws/credentials en cada sesión del lab. No se ponen aquí.
# Solo para pruebas locales; en la nube se lee de Secrets Manager / SSM:
GEMINI_API_KEY=
