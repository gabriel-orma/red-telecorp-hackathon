{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "incidente-colectivo.schema.json",
  "title": "Incidente colectivo (entrada y estado del workflow)",
  "type": "object",
  "required": [
    "incidenteColectivoId",
    "zonaId",
    "origen",
    "detectadoEn",
    "estado"
  ],
  "properties": {
    "incidenteColectivoId": {
      "type": "string",
      "pattern": "^COL-"
    },
    "zonaId": {
      "type": "string"
    },
    "origen": {
      "type": "string",
      "enum": [
        "REPORTES_USUARIOS",
        "METRICAS_ANTENA",
        "AMBOS"
      ],
      "description": "REPORTES_USUARIOS = regla de ≥10 usuarios/24 h; METRICAS_ANTENA = detección proactiva"
    },
    "detectadoEn": {
      "type": "string",
      "format": "date-time"
    },
    "resueltoEn": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "estado": {
      "type": "string",
      "enum": [
        "EN_EVALUACION",
        "INCIDENCIA_CONFIRMADA",
        "SERVICIO_RESTABLECIDO",
        "CERRADO",
        "REQUIERE_ATENCION"
      ],
      "description": "Cada estado dispara su notificación a los afectados. REQUIERE_ATENCION: el monitoreo se agotó o el flujo falló; lo gestiona una persona (la zona queda libre para nuevas detecciones)"
    },
    "usuariosAfectados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "usuarioId distintos"
    },
    "incidencias": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "incidenciaId agrupadas"
    },
    "antenasEnFalla": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "antenaId": {
            "type": "string"
          },
          "estado": {
            "type": "string",
            "enum": [
              "INHABILITADA",
              "CAIDA",
              "SATURADA"
            ]
          }
        }
      }
    },
    "prioridad": {
      "type": "string",
      "enum": [
        "BAJA",
        "MEDIA",
        "ALTA",
        "CRITICA"
      ]
    },
    "puntajePrioridad": {
      "type": "number"
    },
    "resumenIA": {
      "type": "string",
      "description": "Resumen generado por la IA para el operador"
    },
    "origenDetalle": {
      "type": "string",
      "description": "Explicación breve de por qué se detectó (ej. '12 usuarios en 24 h', 'ANT-008 INHABILITADA')"
    },
    "pasoActual": {
      "type": "string",
      "enum": [
        "DETECTADO",
        "NOTIFICAR_EVALUACION",
        "VERIFICAR_INFRAESTRUCTURA",
        "PRIORIZAR",
        "RESUMIR",
        "CONFIRMAR",
        "NOTIFICAR_CONFIRMADA",
        "NOTIFICAR_SIN_FALLA",
        "ALERTAR_OPERADOR",
        "MONITOREAR",
        "RESTABLECER",
        "NOTIFICAR_RESTABLECIDO",
        "CERRADO",
        "ATENCION_MANUAL"
      ],
      "description": "Paso actual del flujo de Step Functions (para el diagrama)"
    },
    "ejecucionArn": {
      "type": "string",
      "description": "ARN de la ejecución de Step Functions"
    },
    "simulado": {
      "type": "boolean",
      "description": "true si nació de datos simulados (escenario de demo, falla forzada, vecinos ficticios). Tiene su propia ventana y su propio candado por zona y no cuenta en la analítica ni en el estado público operativos. Ausente = operativo"
    },
    "estadoAntesDeAtencion": {
      "type": "string",
      "description": "Estado en que estaba cuando pasó a REQUIERE_ATENCION; el operador lo retoma desde ahí"
    },
    "restablecimientoSolicitado": {
      "type": "boolean",
      "description": "El operador marcó el servicio como restablecido"
    },
    "primerReporteEn": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "primeraFallaEn": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Primera falla de antena detectada en la zona"
    },
    "notificacionesEnviadas": {
      "type": "integer"
    },
    "deteccionAnticipadaMin": {
      "type": [
        "number",
        "null"
      ],
      "description": "Solo en el API: minutos entre la primera falla de antena y el primer reporte de usuario. Positivo = la red lo detectó antes"
    },
    "analisisIA": {
      "type": "object",
      "description": "Análisis del incidente para el operador. fuente=IA (Gemini sobre datos agregados, sin datos personales) o REGLAS (plantilla determinista si la IA no está disponible). La IA NO decide umbrales ni prioridad.",
      "required": [
        "fuente",
        "proveedor",
        "generadoEn",
        "resumen",
        "hipotesisCausa",
        "recomendaciones",
        "confianza"
      ],
      "properties": {
        "fuente": {
          "enum": [
            "IA",
            "REGLAS"
          ]
        },
        "proveedor": {
          "enum": [
            "gemini",
            "reglas"
          ]
        },
        "modelo": {
          "type": [
            "string",
            "null"
          ]
        },
        "generadoEn": {
          "type": "string",
          "format": "date-time"
        },
        "motivoFallback": {
          "type": "string",
          "description": "Solo con fuente=REGLAS: por qué no respondió la IA."
        },
        "basadoEn": {
          "type": "object",
          "description": "Datos con los que se generó el análisis; si cambian, el monitoreo lo regenera.",
          "properties": {
            "afectados": {"type": "integer", "minimum": 0},
            "antenasEnFalla": {"type": "integer", "minimum": 0}
          }
        },
        "resumen": {
          "type": "string",
          "maxLength": 600
        },
        "hipotesisCausa": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "causa",
              "probabilidad",
              "evidencia"
            ],
            "properties": {
              "causa": {
                "type": "string"
              },
              "probabilidad": {
                "enum": [
                  "ALTA",
                  "MEDIA",
                  "BAJA"
                ]
              },
              "evidencia": {
                "type": "string"
              }
            }
          }
        },
        "recomendaciones": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string"
          }
        },
        "confianza": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "motivoFallback": {
          "type": "string",
          "description": "Solo si fuente=REGLAS por fallo de la IA (LIMITE, DISYUNTOR, HTTP_429, SALIDA_INVALIDA…)"
        },
        "clima": {
          "type": [
            "object",
            "null"
          ],
          "description": "Clima de la zona al generar el análisis (Azure Maps); null si no estuvo disponible",
          "properties": {
            "fuente": {
              "const": "AzureMaps"
            },
            "frase": {
              "type": "string"
            },
            "temperaturaC": {
              "type": "number"
            },
            "precipitacion": {
              "type": "boolean"
            },
            "vientoKmH": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
