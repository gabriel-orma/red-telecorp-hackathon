{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "antena-estado.schema.json",
  "title": "Estado actual de una antena (último valor clasificado)",
  "type": "object",
  "required": [
    "antenaId",
    "zonaId",
    "estado",
    "gbPorMinuto",
    "actualizadoEn",
    "estadoDesde"
  ],
  "properties": {
    "antenaId": {
      "type": "string",
      "pattern": "^ANT-"
    },
    "zonaId": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "INHABILITADA",
        "CAIDA",
        "NORMAL",
        "SATURADA"
      ]
    },
    "gbPorMinuto": {
      "type": "number",
      "minimum": 0
    },
    "actualizadoEn": {
      "type": "string",
      "format": "date-time",
      "description": "Última métrica recibida"
    },
    "estadoDesde": {
      "type": "string",
      "format": "date-time",
      "description": "Desde cuándo está en el estado actual"
    },
    "simulada": {
      "type": "boolean",
      "description": "La lectura actual viene de una falla forzada del simulador (no es un dato operativo). Ausente o false = operativo"
    },
    "estructural": {
      "type": [
        "object",
        "null"
      ],
      "description": "Marcado por la Step Function de recurrencia (E6)",
      "properties": {
        "desde": {
          "type": "string",
          "format": "date-time"
        },
        "fallas": {
          "type": "integer"
        },
        "ventanaDias": {
          "type": "integer"
        }
      }
    }
  }
}
