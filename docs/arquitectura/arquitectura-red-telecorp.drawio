os" style="text;html=1;align=center;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1180" y="104" width="520" height="20" as="geometry"/></mxCell><mxCell id="n8" value="Salidas / otras nubes" style="text;html=1;align=center;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1710" y="104" width="170" height="20" as="geometry"/></mxCell><mxCell id="n9" value="Concurrencia (D14)" style="text;html=1;align=center;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1890" y="104" width="290" height="20" as="geometry"/></mxCell><mxCell id="n10" value="1 · Panel, portal y frontend" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="2160" height="190" as="geometry"/></mxCell><mxCell id="n11" value="" style="rounded=1;arcSize=6;fillColor=#EAF6EA;strokeColor=#1D8102;" vertex="1" parent="1"><mxGeometry x="1890" y="138" width="290" height="174" as="geometry"/></mxCell><mxCell id="n12" value="2 · Reporte de un ciudadano" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="2160" height="190" as="geometry"/></mxCell><mxCell id="n13" value="" style="rounded=1;arcSize=6;fillColor=#EAF6EA;strokeColor=#1D8102;" vertex="1" parent="1"><mxGeometry x="1890" y="338" width="290" height="174" as="geometry"/></mxCell><mxCell id="n14" value="3 · Métricas de las antenas" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="530" width="2160" height="190"