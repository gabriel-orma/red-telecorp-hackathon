x="1" parent="1"><mxGeometry x="1194" y="1019" width="60" height="60" as="geometry"/></mxCell><mxCell id="n81" value="tope 1" style="rounded=1;arcSize=50;html=1;fillColor=#1D8102;strokeColor=none;fontColor=#FFFFFF;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1230" y="1013" width="44" height="18" as="geometry"/></mxCell><mxCell id="n82" value="WebSocket API" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="1400" y="1025" width="48" height="48" as="geometry"/></mxCell><mxCell id="n83" value="colectivos (stream)&lt;br&gt;+ conexiones" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="960" y="1025" width="48" height="48" as="geometry"/></mxCell><mxCell id="n84" value="Paneles abiertos" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.client;" vertex="1" parent="1"><mxGeometry x="1720" y="1025" width="48" height="48" as="geometry"/></mxCell><mxCell id="n85" value="stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;strokeColor=#545B64;fontSize=9;fontColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n83" target="n79"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n86" value="post_to_connection" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;strokeColor=#545B64;fontSize=9;fontColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n79" target="n82"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n87" value="aviso {tipo}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;strokeColor=#545B64;fontSize=9;fontColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n82" target="n84"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n88" value="SFN escenario&lt;br&gt;Map ×1 + Wait" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1"><mxGeometry x="1200" y="1205" width="48" height="48" as="geometry"/></mxCell><mxCell id="n89" value="SFN recurrencia&lt;br&gt;Map ×1 (cron 06:00)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1"><mxGeometry x="1400" y="1205" width="48" height="48" as="geometry"/></mxCell><mxCell id="n90" value="λ detector (misma)&lt;br&gt;escenario · recurrencia&lt;br&gt;+ barrido 5 min" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1580" y="1205" width="48" height="48" as="geometry"/></mxCell><mxCell id="n91" value="" style="rounded=1;fillColor=none;strokeColor=#ED7100;dashed=1;" vertex="1" parent="1"><mxGeometry x="1574" y="1199" width="60" height="60" as="geometry"/></mxCell><mxCell id="n92" value="tope 2" style="rounded=1;arcSize=50;html=1;fillColor=#1D8102;strokeColor=none;fontColor=#FFFFFF;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1610" y="1193" width="44" height="18" as="geometry"/></mxCell><mxCell id="n93" value="SSM Parameter Store&lt;br&gt;reglas · simulador · escenario" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;" vertex="1" parent="1"><mxGeometry x="960" y="1205" width="48" height="48" as="geometry"/></mxCell><mxCell id="n94" value="Secrets Manager&lt;br&gt;Cloudflare · Gemini · Azure" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1"><mxGeometry x="1100" y="1205" width="48" height="48" as="geometry"/></mxCell><mxCell id="n95" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;strokeColor=#545B64;fontSize=9;fontColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n88" target="n90"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n96" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;strokeColor=#545B64;fontSize=9;fontColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n89" target="n90"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n97" value="reportes simulados" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;strokeColor=#545B64;fontSize=9;fontColor=#545B64;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="n90" target="n41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n98" value="Cloudflare Workers + KV&lt;br&gt;espejo del estado público" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F38020;strokeColor=#C2620A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1720" y="1205" width="150" height="50" as="geometry"/></mxCell><mxCell id="n99" value="PUT /publicar&lt;br&gt;(token, ≤ 1 cada 4 min)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;strokeColor=#545B64;fontSize=9;fontColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n90" target="n98"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n100" value="&lt;b&gt;Tope 2.&lt;/b&gt; Las 26 rutas comparten la misma función: si llegan más pedidos, API Gateway responde «ocupado» y el navegador reintenta. El frontend (index, JS, CSS, fuentes) &lt;b&gt;no usa Lambda&lt;/b&gt;: va de S3 por el HTTP API. Si /api/estado no responde, la página pública lee la copia de &lt;b&gt;Cloudflare&lt;/b&gt; (carril 6)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;spacing=6;" vertex="1" parent="1"><mxGeometry x="1894" y="140" width="282" height="170" as="geometry"/></mxCell><mxCell id="n101" value="&lt;b&gt;Tope 1.&lt;/b&gt; La cola SQS absorbe cualquier ráfaga (prueba de carga, escenarios): los reportes esperan su turno y se registran de a un lote. Si la función está ocupada el mensaje vuelve a la cola: nada se pierde." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;spacing=6;" vertex="1" parent="1"><mxGeometry x="1894" y="340" width="282" height="170" as="geometry"/></mxCell><mxCell id="n102" value="&lt;b&gt;Tope 1.&lt;/b&gt; Simulador y clasificador son la misma función. El simulador ya no duerme dentro de la Lambda: SQS entrega cada muestra a su hora (retraso de 0, 15, 30 y 45 s)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;spacing=6;" vertex="1" parent="1"><mxGeometry x="1894" y="540" width="282" height="170" as="geometry"/></mxCell><mxCell id="n103" value="&lt;b&gt;Tope 2.&lt;/b&gt; Detector, barrido y los 17 pasos de las 3 Step Functions son UNA función. Cada tarea reintenta &lt;i&gt;Lambda.TooManyRequestsException&lt;/i&gt; (hasta 40 veces con espera creciente) antes que cualquier otro error: si el motor está ocupado, el incidente espera; no falla." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;spacing=6;" vertex="1" parent="1"><mxGeometry x="1894" y="740" width="282" height="220" as="geometry"/></mxCell><mxCell id="n104" value="Los avisos comparten el tope 1 de segundo plano (si se atrasan, el panel igual se actualiza por su polling). $connect / $disconnect / ping usan el router (tope 2)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;spacing=6;" vertex="1" parent="1"><mxGeometry x="1894" y="990" width="282" height="150" as="geometry"/></mxCell><mxCell id="n105" value="&lt;b&gt;Total de la cuenta: api 2 + segundoPlano 1 + simulador 1 + detector 2 + preRegistro 1 = 7 de 10.&lt;/b&gt; Quedan 3 para las Lambdas propias del laboratorio. Una prueba automática falla si una función no tiene tope o si la suma pasa de 7. &lt;b&gt;Cloudflare&lt;/b&gt; (D15) recibe el estado desde el barrido que ya existía: 0 Lambdas nuevas." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;spacing=6;" vertex="1" parent="1"><mxGeometry x="1894" y="1170" width="282" height="180" as="geometry"/></mxCell><mxCell id="n106" value="&lt;b&gt;Leyenda&lt;/b&gt;: etiqueta verde = tope de concurrencia de la Lambda (reservedConcurrency) · recuadro punteado = la misma Lambda en otro flujo · línea punteada = opcional / ocasional · CloudWatch: logs + alarmas de las DLQ + métrica ConcurrentExecutions" style="text;html=1;align=left;fontSize=10;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="20" y="1372" width="2160" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>