Icon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="960" y="1025" width="48" height="48" as="geometry"/></mxCell><mxCell id="n86" value="Paneles abiertos" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.client;" vertex="1" parent="1"><mxGeometry x="1720" y="1025" width="48" height="48" as="geometry"/></mxCell><mxCell id="n87" value="stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;strokeColor=#545B64;fontSize=9;fontColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n85" target="n81"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n88" value="post_to_connection" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;strokeColor=#545B64;fontSize=9;fontColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n81" target="n83"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n89" value="aviso {tipo}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;strokeColor=#545B64;fontSize=9;fontColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n83" target="n86"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;strokeColor=#545B64;fontSize=9;fontColor=#545B64;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="n83" target="n84"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n91" value="SFN escenario&lt;br&gt;Map ×1 + Wait (3–12 s)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1"><mxGeometry x="1200" y="1205" width="48" height="48" as="geometry"/></mxCell><mxCell id="n92" value="λ ×3 escenario&lt;br&gt;preparar · oleada · finalizar" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1340" y="1205" width="48" height="48" as="geometry"/></mxCell><mxCell id="n93" value="Scheduler&lt;br&gt;cron 06:00 Lima" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="1"><mxGeometry x="200" y="1205" width="48" height="48" as="geometry"/></mxCell><mxCell id="n94" value="SFN recurrencia&lt;br&gt;Map ×5" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1"><mxGeometry x="1520" y="1205" width="48" height="48" as="geometry"/></mxCell><mxCell id="n95" value="SSM Parameter Store&lt;br&gt;reglas · simulador · escenario" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;" vertex="1" parent="1"><mxGeometry x="960" y="1205" width="48" height="48" as="geometry"/></mxCell><mxCell id="n96" value="Secrets Manager&lt;br&gt;Azure · IA" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1"><mxGeometry x="1060" y="1205" width="48" height="48" as="geometry"/></mxCell><mxCell id="n97" value="lanza escenario" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;strokeColor=#545B64;fontSize=9;fontColor=#545B64;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="n27" target="n91"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n98" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;strokeColor=#545B64;fontSize=9;fontColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n91" target="n92"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n99" value="fuerza fallas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;strokeColor=#545B64;fontSize=9;fontColor=#545B64;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="n92" target="n95"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n100" value="reportes simulados" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D13212;fontSize=9;fontColor=#D13212;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n92" target="n41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n101" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;strokeColor=#545B64;fontSize=9;fontColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n93" target="n94"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n102" value="&lt;b&gt;1 Lambda por pedido HTTP en vuelo.&lt;/b&gt;&lt;br&gt;Cada pantalla pide 3–5 endpoints; con WebSocket se recargan al llegar avisos (throttle 0,7–2,5 s). Varios operadores/pestañas multiplican. &lt;br&gt;&lt;i&gt;Línea de tiempo&lt;/i&gt;: 1 Lambda que abre 16 hilos a DynamoDB." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;spacing=6;" vertex="1" parent="1"><mxGeometry x="1894" y="140" width="282" height="170" as="geometry"/></mxCell><mxCell id="n103" value="&lt;b&gt;⚠ SQS → Lambda escala sola&lt;/b&gt; (empieza con ~5 lectores y sube si la cola crece). Una ráfaga de reportes (prueba de carga, escenarios) = varias Lambdas registrarReporte a la vez. Reintentos internos por conflictos de transacción alargan cada invocación." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;spacing=6;" vertex="1" parent="1"><mxGeometry x="1894" y="340" width="282" height="170" as="geometry"/></mxCell><mxCell id="n104" value="&lt;b&gt;⚠ Carga constante 24/7 mientras el simulador esté encendido.&lt;/b&gt; El simulador ocupa ~1 instancia casi todo el minuto y los escenarios lo invocan de nuevo (se solapa → 2). El clasificador recibe 144 mensajes/min → 1–3 instancias." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;spacing=6;" vertex="1" parent="1"><mxGeometry x="1894" y="540" width="282" height="170" as="geometry"/></mxCell><mxCell id="n105" value="&lt;b&gt;⚠ Se multiplica por incidente abierto.&lt;/b&gt; Cada incidente = 1 ejecución que llama Lambdas en cada paso y Map ×5 para avisar (hasta 5 Lambdas notificarLote a la vez por incidente). Monitoreo cada 30 s (4 s en la simulación acelerada). 4 incidentes simultáneos → hasta ~20 Lambdas." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;spacing=6;" vertex="1" parent="1"><mxGeometry x="1894" y="740" width="282" height="220" as="geometry"/></mxCell><mxCell id="n106" value="&lt;b&gt;1 Lambda por stream y shard&lt;/b&gt; (antenas, colectivos, incidencias) → ~3 constantes mientras haya cambios. Cada aviso hace que cada panel abierto vuelva a pedir datos al carril 1." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;spacing=6;" vertex="1" parent="1"><mxGeometry x="1894" y="990" width="282" height="150" as="geometry"/></mxCell><mxCell id="n107" value="&lt;b&gt;⚠ Un escenario dispara todos los carriles a la vez:&lt;/b&gt; reportes (2), lecturas forzadas (3), incidentes (4) y avisos (5). Simulación acelerada: 60 oleadas cada 3 s, ~80 reportes y 4 incidentes en 3 min → pico estimado &lt;b&gt;35–50 Lambdas concurrentes&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;spacing=6;" vertex="1" parent="1"><mxGeometry x="1894" y="1170" width="282" height="180" as="geometry"/></mxCell><mxCell id="n108" value="&lt;b&gt;Leyenda&lt;/b&gt;: flecha roja = punto donde se acumulan invocaciones en paralelo · círculo rojo = Lambda con riesgo de concurrencia · línea punteada = opcional / ocasional · CloudWatch: logs de todas las Lambdas + alarmas sobre las DLQ" style="text;html=1;align=left;fontSize=10;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="20" y="1372" width="2160" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>